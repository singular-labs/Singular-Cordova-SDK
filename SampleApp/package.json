    "cordova-custom-config": "^5.1.1",
    "cordova-ios": "^6.2.0",
    "cordova-plugin-dialogs": "^2.0.2",
    "cordova-plugin-firebasex": "^18.0.6",
    "cordova-plugin-purchase": "^11.0.0",
    "cordova-plugin-wkwebview-file-xhr": "^3.1.0",
    "singular_cordova_sdk": "file:../SingularCordovaSdk"
